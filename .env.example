# Required — get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional overrides (defaults shown)
# GROQ_CHAT_MODEL=llama-3.3-70b-versatile
# LLM_TEMPERATURE=0.0
# LLM_MAX_TOKENS=1024

# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDING_DEVICE=cpu

# CHROMA_PERSIST_DIR=./data/chroma
# CHROMA_COLLECTION=documents

# UPLOAD_DIR=./data/uploads
# MAX_UPLOAD_SIZE_MB=25

# RETRIEVAL_K=5
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200
# MAX_CONVERSATION_TURNS=5

# CORS_ORIGINS=["http://localhost:3000"]

# Auth — JSON map of API key -> user id. Clients send the key as `X-API-Key`.
# Generate keys with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Set AUTH_ENABLED=false ONLY for local dev (everyone becomes "anonymous").
# AUTH_ENABLED=true
# API_KEYS={"replace-with-generated-key": "alice"}
# MAX_DOCS_PER_USER=50

# Frontend (frontend/.env.local) — demo only, visible to the browser:
# NEXT_PUBLIC_API_KEY=replace-with-generated-key

# Shared state (leave empty for single-process dev with in-memory fallbacks).
# Docker Compose sets these for you; compose also needs POSTGRES_PASSWORD.
# DATABASE_URL=postgresql+psycopg://rag:password@localhost:5432/rag
# REDIS_URL=redis://localhost:6379/0     # sessions + ingestion queue (run: arq worker.WorkerSettings)
# CHROMA_HOST=localhost                  # Chroma server; required when running a separate worker
# CHROMA_PORT=8000
# SESSION_TTL_SECONDS=86400
# INGEST_MAX_TRIES=3
# INGEST_STALE_MINUTES=30
# POSTGRES_PASSWORD=change-me

# Observability
# ENVIRONMENT=production
# LOG_FORMAT=json          # "text" for local dev
# LOG_LEVEL=INFO
# SENTRY_DSN=              # optional error tracking
# WEB_CONCURRENCY=2        # gunicorn workers (each loads the embedding model, ~0.5-1 GB RAM)
# DOMAIN=localhost         # public hostname for Caddy (automatic HTTPS for real domains)

# Retrieval quality
# HYBRID_ENABLED=true          # BM25 keyword search fused with semantic search
# RERANK_ENABLED=true          # cross-encoder rerank of the shortlist
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# RETRIEVAL_CANDIDATES=20
# MIN_RELEVANCE_SCORE=0.01     # chunks below this are dropped; if none remain the API says it can't answer
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_RETRIES=3
# GROQ_FALLBACK_MODEL=llama-3.1-8b-instant   # empty disables fallback
